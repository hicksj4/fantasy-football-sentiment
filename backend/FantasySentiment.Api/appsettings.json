{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=55432;Database=fantasy_sentiment;Username=fantasy;Password=replace-with-local-password"
  },
  "Reddit": {
    "UseMockReddit": true,
    "Subreddits": [ "fantasyfootball" ],
    "IngestionIntervalSeconds": 45,
    "FetchLookbackMinutes": 90,
    "ClientId": "",
    "ClientSecret": "",
    "UserAgent": "FantasySentimentTerminal/0.1 by local-dev"
  },
  "Snapshots": {
    "IntervalMinutes": 5,
    "RecentWindowMinutes": 60,
    "BaselineWindowHours": 24
  },
  "Sentiment": {
    "Mode": "Comparison",
    "EnableComparisonDiagnostics": true,
    "Roberta": {
      "Enabled": false,
      "ModelPath": "Models/Sentiment/model.onnx",
      "OnnxModelPath": "",
      "TokenizerPath": "Models/Sentiment/tokenizer.json",
      "ConfigPath": "Models/Sentiment/config.json",
      "TokenizerConfigPath": "Models/Sentiment/tokenizer_config.json",
      "MaxSequenceLength": 512
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
