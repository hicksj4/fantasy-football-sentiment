{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=55432;Database=fantasy_sentiment;Username=fantasy;Password=replace-with-local-password"
  },
  "Reddit": {
    "UseMockReddit": true,
    "Subreddits": [ "fantasyfootball" ],
    "FetchLookbackMinutes": 240,
    "ClientId": "",
    "ClientSecret": "",
    "UserAgent": "FantasySentimentTerminal/0.1 by local-dev"
  },
  "RedditAnalysis": {
    "DiscoveryIntervalMinutes": 10,
    "AnalysisIntervalMinutes": 2,
    "MaxPostsPerAnalysisBatch": 3,
    "IncrementalMinimumNewComments": 1,
    "NormalPosts": {
      "MinimumComments": 100,
      "MinimumCommentsWithScore": 40,
      "MinimumPostScore": 50
    },
    "ImportantNews": {
      "MinimumComments": 30,
      "Keywords": [
        "injury",
        "injured",
        "ir",
        "out",
        "questionable",
        "doubtful",
        "trade",
        "suspension",
        "depth chart",
        "starter",
        "backup"
      ]
    },
    "GameThreads": {
      "MinimumComments": 300,
      "MinimumAgeMinutes": 120,
      "CooldownWindowMinutes": 15,
      "MaximumNewCommentsDuringCooldown": 20,
      "TitlePatterns": [
        "game thread",
        "post game thread",
        "monday night football",
        "sunday night football",
        "thursday night football"
      ]
    }
  },
  "Snapshots": {
    "IntervalMinutes": 5,
    "RecentWindowMinutes": 60,
    "BaselineWindowHours": 24
  },
  "DashboardHighlights": {
    "MinimumMentions": 5,
    "MinimumSampleStrength": 0.25,
    "ExcludeLowConfidence": true,
    "MinimumAbsoluteSentimentChange": 0.05,
    "CommentExcerptLength": 190
  },
  "Sentiment": {
    "Mode": "Vader",
    "EnableComparisonDiagnostics": true,
    "Roberta": {
      "Enabled": false,
      "OnnxModelPath": "",
      "TokenizerPath": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
